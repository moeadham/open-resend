{
  "name": "cloudflare-resend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "esbuild assets/admin.ts assets/admin.css --bundle --minify --outdir=dist-assets/assets",
    "check": "npm run build:assets && npm run types && tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "predev": "npm run build:assets",
    "dev": "wrangler dev",
    "predeploy:dry": "npm run check",
    "deploy:dry": "wrangler deploy --dry-run",
    "predeploy": "npm run check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mimetext": "^3.0.28",
    "quill": "2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.30",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.1",
    "resend": "6.32.0",
    "typescript": "^5.9.3",
    "vitest": "3.1.4",
    "wrangler": "^4.147.0"
  }
}
