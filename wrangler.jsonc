{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-resend",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./dist-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-resend",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROADCAST_SCHEDULE",
        "class_name": "BroadcastSchedule"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BroadcastSchedule"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DELIVERY_QUEUE",
        "queue": "cloudflare-resend-deliveries"
      },
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "cloudflare-resend-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "cloudflare-resend-deliveries",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cloudflare-resend-deliveries-dlq"
      },
      {
        "queue": "cloudflare-resend-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "cloudflare-resend-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "cloudflare-resend-webhooks",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "DELIVERY_QUEUE_NAME": "cloudflare-resend-deliveries",
    "DEAD_LETTER_QUEUE_NAME": "cloudflare-resend-deliveries-dlq",
    "EMAIL_EVENTS_QUEUE_NAME": "cloudflare-resend-email-events",
    "ADMIN_HOSTNAME": "admin.example.com",
    "API_HOSTNAME": "api.example.com",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    "UNSUBSCRIBE_HOSTNAMES": "{\"example.com\":\"mail.example.com\"}",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "local-development-audience",
    "ENVIRONMENT": "development",
    "ALLOW_LOCAL_ADMIN": "true",
    "WEBHOOK_QUEUE_NAME": "cloudflare-resend-webhooks",
    "INBOUND_AUTH_RESULTS_VERIFIED": "false",
    "WORKER_NAME": "cloudflare-resend",
    "API_HOSTNAME_ALIASES": ""
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "EMAIL_STORAGE",
      "bucket_name": "cloudflare-resend-email"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
