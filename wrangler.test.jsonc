{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-resend-test",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-resend-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BROADCAST_SCHEDULE", "class_name": "BroadcastSchedule" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BroadcastSchedule"] }
  ],
  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "cloudflare-resend-test-deliveries" }
    ],
    "consumers": [
      {
        "queue": "cloudflare-resend-test-deliveries",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cloudflare-resend-test-deliveries-dlq"
      },
      {
        "queue": "cloudflare-resend-test-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      },
      {
        "queue": "cloudflare-resend-test-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "vars": {
    "ADMIN_HOSTNAME": "admin.example.com",
    "API_HOSTNAME": "api.example.com",
    "UNSUBSCRIBE_HOSTNAMES": "{\"example.com\":\"mail.example.com\"}",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "local-development-audience",
    "ENVIRONMENT": "development",
    "ALLOW_LOCAL_ADMIN": "true"
  }
}
